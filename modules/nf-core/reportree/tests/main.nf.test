nextflow_process {

    name "Test Process REPORREE"
    script "modules/nf-core/reportree/main.nf"
    process "REPORTREE"

    tag "modules"
    tag "modules_nfcore"
    tag "reportree"

    test("reporree stub") {

        when {
            options "-stub"
            process {
                """
                input[0] = Channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + '/reportree/test_metadata.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_allele_profile.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_partitions.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_tree.nwk', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_alignment.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.vcf', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_distance_matrix.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_sequences.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("reporree with metadata only") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + '/reportree/test_metadata.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_allele_profile.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_partitions.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_tree.nwk', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_alignment.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.vcf', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_distance_matrix.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_sequences.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("reporree with metadata and allele profile") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + '/reportree/test_metadata.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_allele_profile.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_partitions.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_tree.nwk', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_alignment.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.vcf', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_distance_matrix.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_sequences.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("reporree with metadata and partitions") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [id: 'test'],
                    file(params.modules_testdata_base_path + '/reportree/test_metadata.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_allele_profile.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_partitions.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_tree.nwk', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_alignment.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.vcf', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_variants.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/reportree/test_distance_matrix.tsv', checkIfExists: true),
