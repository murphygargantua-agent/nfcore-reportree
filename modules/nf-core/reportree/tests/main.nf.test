nextflow_process {

    name "Test Process REPORTREE"
    script "modules/nf-core/reportree/main.nf"
    process "REPORTREE"

    tag "modules"
    tag "modules_nfcore"
    tag "reportree"

    def repoRoot = System.getProperty('user.dir')
    def repoFile = new java.io.File(repoRoot, 'modules/nf-core/reportree/main.nf')
    if (!repoFile.exists()) {
        repoRoot = new java.io.File(repoRoot, '..').getCanonicalPath()
        repoFile = new java.io.File(repoRoot, 'modules/nf-core/reportree/main.nf')
        if (!repoFile.exists()) {
            repoRoot = new java.io.File(repoRoot, '..').getCanonicalPath()
            repoFile = new java.io.File(repoRoot, 'modules/nf-core/reportree/main.nf')
            if (!repoFile.exists()) {
                repoRoot = new java.io.File(repoRoot, '..').getCanonicalPath()
                repoFile = new java.io.File(repoRoot, 'modules/nf-core/reportree/main.nf')
            }
        }
    }
    def data = repoRoot + "/tests/data/reportree"

    test("reportree stub") {

        when {
            options "-stub"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('$data/test_metadata.tsv', checkIfExists: true),
                    file('$data/test_allele_profile.tsv', checkIfExists: true),
                    file('$data/test_partitions.tsv', checkIfExists: true),
                    file('$data/test_tree.nwk', checkIfExists: true),
                    file('$data/test_alignment.fasta', checkIfExists: true),
                    file('$data/test_variants.vcf', checkIfExists: true),
                    file('$data/test_variants.tsv', checkIfExists: true),
                    file('$data/test_distance_matrix.tsv', checkIfExists: true),
                    file('$data/test_sequences.fasta', checkIfExists: true),
                    file('$data/test_nomenclature.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("reportree with metadata and allele profile") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('$data/test_metadata.tsv', checkIfExists: true),
                    file('$data/test_allele_profile.tsv', checkIfExists: true),
                    file('$data/test_partitions.tsv', checkIfExists: true),
                    file('$data/test_tree.nwk', checkIfExists: true),
                    file('$data/test_alignment.fasta', checkIfExists: true),
                    file('$data/test_variants.vcf', checkIfExists: true),
                    file('$data/test_variants.tsv', checkIfExists: true),
                    file('$data/test_distance_matrix.tsv', checkIfExists: true),
                    file('$data/test_sequences.fasta', checkIfExists: true),
                    file('$data/test_nomenclature.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("reportree with metadata and partitions") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('$data/test_metadata.tsv', checkIfExists: true),
                    file('$data/test_allele_profile.tsv', checkIfExists: true),
                    file('$data/test_partitions.tsv', checkIfExists: true),
                    file('$data/test_tree.nwk', checkIfExists: true),
                    file('$data/test_alignment.fasta', checkIfExists: true),
                    file('$data/test_variants.vcf', checkIfExists: true),
                    file('$data/test_variants.tsv', checkIfExists: true),
                    file('$data/test_distance_matrix.tsv', checkIfExists: true),
                    file('$data/test_sequences.fasta', checkIfExists: true),
                    file('$data/test_nomenclature.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("reportree with metadata and tree") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('$data/test_metadata.tsv', checkIfExists: true),
                    file('$data/test_allele_profile.tsv', checkIfExists: true),
                    file('$data/test_partitions.tsv', checkIfExists: true),
                    file('$data/test_tree.nwk', checkIfExists: true),
                    file('$data/test_alignment.fasta', checkIfExists: true),
                    file('$data/test_variants.vcf', checkIfExists: true),
                    file('$data/test_variants.tsv', checkIfExists: true),
                    file('$data/test_distance_matrix.tsv', checkIfExists: true),
                    file('$data/test_sequences.fasta', checkIfExists: true),
                    file('$data/test_nomenclature.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("reportree with Zenodo Chlamydia trachomatis data") {

        when {
            params {
                loci_called = "0.95"
                analysis = "HC"
                hc_threshold = "single-475,single-75,single-25,single-10"
                columns_summary_report = "lineage,country,anatomical_site"
                metadata2report = "lineage"
                nomenclature_code_levels = "single-475,single-75,single-25"
            }
            process {
                """
                def repoRoot2 = System.getProperty('user.dir')
                def repoFile2 = new java.io.File(repoRoot2, 'modules/nf-core/reportree/main.nf')
                if (!repoFile2.exists()) {
                    repoRoot2 = new java.io.File(repoRoot2, '..').getCanonicalPath()
                    repoFile2 = new java.io.File(repoRoot2, 'modules/nf-core/reportree/main.nf')
                    if (!repoFile2.exists()) {
                        repoRoot2 = new java.io.File(repoRoot2, '..').getCanonicalPath()
                        repoFile2 = new java.io.File(repoRoot2, 'modules/nf-core/reportree/main.nf')
                        if (!repoFile2.exists()) {
                            repoRoot2 = new java.io.File(repoRoot2, '..').getCanonicalPath()
                            repoFile2 = new java.io.File(repoRoot2, 'modules/nf-core/reportree/main.nf')
                        }
                    }
                }
                def zenodo = repoRoot2 + "/tests/data/reportree/zenodo/subset"
                input[0] = [
                    [ id:'zenodo' ],
                    file(zenodo + '/Ct_metadata.tsv', checkIfExists: true),
                    file(zenodo + '/Ct_alleles_missing_code_0.tsv', checkIfExists: true),
                    file(zenodo + '/Ct_partitions_to_setup_HC_nomenclature.tsv', checkIfExists: true),
                    file(zenodo + '/Ct_partitions_to_setup_GT_nomenclature.tsv', checkIfExists: true),
                    file('missing1', checkIfExists: false),
                    file('missing2', checkIfExists: false),
                    file('missing3', checkIfExists: false),
                    file('missing4', checkIfExists: false),
                    file('missing5', checkIfExists: false),
                    file('missing6', checkIfExists: false)
                ]
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.metadata_w_partitions[0][1]).exists()
            assert file(process.out.partitions_summary[0][1]).exists()
            assert file(process.out.variable_summary[0][1]).exists()
            assert file(process.out.partitions[0][1]).exists()
        }
    }
}
